<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog id="reportDialog"
        title="{i18n>reportTitle}"
        verticalScrolling="true"
        stretch="true">

        <content>
            <VBox class="sapUiSmallMarginBeginEnd sapUiSmallMarginTopBottom">
                <Label text="{i18n>reportWhat}" class="sapUiTinyMarginBottom"/>
                <Select id="reportCategorySelect"
                    selectedKey="{appData>/report/category}"
                    width="100%"
                    class="sapUiSmallMarginBottom">
                    <items>
                        <core:Item key=""                       text="{i18n>reportSelectCategory}"/>
                        <core:Item key="spam"                   text="{i18n>reportSpam}"/>
                        <core:Item key="harassment"             text="{i18n>reportHarassment}"/>
                        <core:Item key="scam_fraud"             text="{i18n>reportScam}"/>
                        <core:Item key="inappropriate_content"  text="{i18n>reportInappropriate}"/>
                        <core:Item key="fake_profile"           text="{i18n>reportFakeProfile}"/>
                        <core:Item key="other"                  text="{i18n>reportOther}"/>
                    </items>
                </Select>
                <Label text="{i18n>reportDescription}" class="sapUiTinyMarginBottom"/>
                <TextArea value="{appData>/report/description}"
                    rows="4"
                    width="100%"
                    placeholder="{i18n>reportDescPlaceholder}"
                    class="sapUiSmallMarginBottom"/>
                <Text text="{i18n>reportAnonymousNote}"
                    class="smallText grayText" wrapping="true"/>
            </VBox>
        </content>

        <beginButton>
            <Button text="{i18n>reportSubmitBtn}" type="Emphasized" press="onSubmitReport"/>
        </beginButton>
        <endButton>
            <Button text="{i18n>cancel}" press="onCloseReport"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>
