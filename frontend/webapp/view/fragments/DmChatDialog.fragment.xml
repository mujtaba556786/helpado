<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog id="dmChatDialog" title="{appData>/currentDmOtherName}"
        verticalScrolling="false"
        stretch="true">

        <customHeader>
            <Bar>
                <contentLeft>
                    <Button icon="sap-icon://nav-back" type="Transparent" press="onCloseDmChat"/>
                </contentLeft>
                <contentMiddle>
                    <Title text="{appData>/currentDmOtherName}"/>
                </contentMiddle>
                <contentRight>
                    <Button id="dmChatMenuBtn" icon="sap-icon://overflow" tooltip="{i18n>chatOptions}" type="Transparent" press="onDmChatMenu"/>
                    <Button icon="sap-icon://decline" tooltip="{i18n>close}" type="Transparent" press="onCloseDmChat"/>
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <FlexBox direction="Column" height="100%" fitContainer="true">
                <items>
                    <!-- Messages — real UI5 controls so they follow the theme and are matchable in OPA5 -->
                    <ScrollContainer id="dmScrollContainer" vertical="true" horizontal="false" width="100%">
                        <layoutData><FlexItemData growFactor="1" shrinkFactor="1" baseSize="0"/></layoutData>
                        <List id="dmMessageList"
                            items="{appData>/dmMessages}"
                            showSeparators="None"
                            backgroundDesign="Transparent"
                            noDataText="{i18n>noMessagesYet}"
                            width="100%">
                            <!-- Own bubbles open Bearbeiten / Löschen (onDmBubblePress ignores
                                 other people's messages and ones already gone). -->
                            <CustomListItem type="{= ${appData>canUnsend} ? 'Active' : 'Inactive' }" press="onDmBubblePress">
                                <HBox width="100%"
                                    justifyContent="{= ${appData>isOwn} ? 'End' : 'Start' }"
                                    class="sapUiTinyMarginTop">
                                    <VBox class="hhBubble">
                                        <customData>
                                            <core:CustomData key="hhown" value="{appData>isOwnStr}" writeToDom="true"/>
                                        </customData>
                                        <!-- class="{= }" renders nothing in UI5; the removed state is a
                                             DOM attribute styled by .hhBubble .sapMText[data-hhremoved="true"]. -->
                                        <Text text="{appData>content}" renderWhitespace="true">
                                            <customData>
                                                <core:CustomData key="hhremoved" value="{appData>removedStr}" writeToDom="true"/>
                                            </customData>
                                        </Text>
                                        <HBox justifyContent="End" alignItems="Center">
                                            <Text text="{appData>editedLabel}" visible="{appData>edited}"
                                                class="hhBubbleMeta sapUiTinyMarginEnd"/>
                                            <Text text="{appData>time}" class="hhBubbleMeta"/>
                                            <Text text="{appData>ticks}"
                                                tooltip="{appData>tickTooltip}"
                                                visible="{appData>isOwn}"
                                                class="hhBubbleMeta sapUiTinyMarginBegin"/>
                                        </HBox>
                                    </VBox>
                                </HBox>
                            </CustomListItem>
                        </List>
                    </ScrollContainer>
                    <!-- Composer — pinned to bottom. A growing TextArea (not an Input) so a
                         long message stays visible and editable before sending; Enter adds a
                         newline and the labelled Send button is the only send action.
                         growFactor makes it fill the bar — width="100%" does not grow a flex
                         child. alignItems=End keeps Send on the last line as the field grows. -->
                    <!-- Edit mode: shown while the composer holds a message being corrected. -->
                    <HBox id="dmEditBar" alignItems="Center" justifyContent="SpaceBetween"
                        visible="{= !!${appData>/dmEditing} }"
                        class="sapUiSmallMarginBeginEnd sapUiTinyMarginTop">
                        <layoutData><FlexItemData shrinkFactor="0"/></layoutData>
                        <HBox alignItems="Center">
                            <core:Icon src="sap-icon://edit" class="sapUiTinyMarginEnd" color="#2E8B57"/>
                            <Text text="{i18n>dmEditingLabel}" class="smallText"/>
                        </HBox>
                        <Button id="dmCancelEditBtn" icon="sap-icon://decline" type="Transparent"
                            tooltip="{i18n>cancel}" press="onDmCancelEdit"/>
                    </HBox>
                    <HBox alignItems="End"
                        class="sapUiSmallMarginBeginEnd sapUiTinyMarginTop sapUiSmallMarginBottom hhComposer">
                        <layoutData><FlexItemData shrinkFactor="0"/></layoutData>
                        <TextArea id="dmInput" placeholder="{i18n>typeMessage}" rows="1"
                            growing="true" growingMaxLines="5" width="100%" class="hhComposerInput">
                            <layoutData><FlexItemData growFactor="1" baseSize="0"/></layoutData>
                        </TextArea>
                        <Button id="dmSendBtn" text="{i18n>sendMessage}" icon="sap-icon://paper-plane"
                            type="Emphasized" press="onDmSend" class="sapUiSmallMarginBegin hhComposerSend"/>
                    </HBox>
                </items>
            </FlexBox>
        </content>

    </Dialog>

</core:FragmentDefinition>
