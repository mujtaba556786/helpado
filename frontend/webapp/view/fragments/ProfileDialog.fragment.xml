<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Dialog id="profileDialog"
        title="{appData>/selectedProfile/name}"
        verticalScrolling="true"
        stretch="true">

        <!-- Safety actions live behind an overflow menu rather than sitting at the
             bottom of every profile. They stay one tap away, but the page no longer
             frames each helper as a potential threat. -->
        <customHeader>
            <Bar>
                <contentMiddle>
                    <Title text="{appData>/selectedProfile/name}" level="H4"/>
                </contentMiddle>
                <contentRight>
                    <Button id="profileOverflowBtn" icon="sap-icon://overflow" type="Transparent"
                        tooltip="{i18n>moreOptions}" press="onProfileOverflow"
                        visible="{appData>/isOtherProfile}"/>
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <VBox>

                <!-- ── Hero ── -->
                <HBox alignItems="Center"
                    class="sapUiMediumMarginBeginEnd sapUiMediumMarginTop sapUiSmallMarginBottom">
                    <Avatar
                        src="{appData>/selectedProfile/photo}"
                        initials="{appData>/selectedProfile/initials}"
                        displaySize="L"
                        class="sapUiMediumMarginEnd"/>
                    <VBox>
                        <Text text="{appData>/selectedProfile/serviceType}" class="smallText"/>
                        <HBox alignItems="Center" class="sapUiTinyMarginTop">
                            <RatingIndicator value="{appData>/selectedProfile/rating}" maxValue="5" visualMode="Half" displayOnly="true" class="sapUiTinyMarginEnd"/>
                            <Text text="{appData>/selectedProfile/ratingLabel}" class="smallText"/>
                        </HBox>
                        <ObjectStatus
                            text="{path:'appData>/selectedProfile/trust_level', formatter:'.formatTrustLabel'}"
                            state="{= ${appData>/selectedProfile/trust_level} === 'trusted_user' ? 'Success' : ${appData>/selectedProfile/trust_level} === 'verified_user' ? 'Information' : 'None' }"
                            visible="{= !!${appData>/selectedProfile/trust_level} }"
                            class="sapUiTinyMarginTop"/>
                    </VBox>
                </HBox>

                <!-- ── Action buttons (only for other people) ── -->
                <HBox justifyContent="SpaceAround"
                    class="sapUiMediumMarginBeginEnd sapUiSmallMarginBottom"
                    visible="{appData>/isOtherProfile}">
                    <Button text="{i18n>book}"    icon="sap-icon://appointment-2" type="Emphasized" press="onOpenBooking"/>
                    <Button text="{i18n>messageAction}" icon="sap-icon://discussion"    type="Default"    press="onStartDm"/>
                    <!-- Ask AI hidden until the feature is ready: /api/chat has no ANTHROPIC_API_KEY
                         set, so every tap fails. Re-enable by removing visible="false" once the key is
                         configured and the route has auth + rate limiting. -->
                    <Button text="Ask AI"  icon="sap-icon://da"            type="Default"    press="onOpenChat" visible="false"/>
                </HBox>

                <!-- ── Edit Profile shortcut (only for own profile) ── -->
                <HBox justifyContent="Center"
                    class="sapUiMediumMarginBeginEnd sapUiSmallMarginBottom"
                    visible="{appData>/isOwnProfile}">
                    <Button text="{i18n>editProfile}" icon="sap-icon://edit" type="Emphasized"
                        press="onEditProfileFromDialog" width="100%"/>
                </HBox>

                <!-- ── Info rows — SAP UI5 StandardListItem: icon | label | value ── -->
                <List showSeparators="Inner" class="sapUiSmallMarginBottom">
                    <StandardListItem
                        icon="sap-icon://money-bills"
                        title="{i18n>bookingRate}"
                        info="{appData>/selectedProfile/rateDisplay}"
                        type="Inactive"/>
                    <StandardListItem
                        icon="sap-icon://history"
                        title="{i18n>profileExperience}"
                        info="{= ${appData>/selectedProfile/years} ? ${appData>/selectedProfile/years} + ' years' : '—'}"
                        type="Inactive"/>
                    <StandardListItem
                        icon="sap-icon://world"
                        title="{i18n>profileLanguage}"
                        info="{= ${appData>/selectedProfile/languages} || '—'}"
                        type="Inactive"/>
                    <StandardListItem
                        icon="sap-icon://map"
                        title="{i18n>location}"
                        info="{= ${appData>/selectedProfile/city} || '—'}"
                        type="Inactive"
                        wrapping="true"/>
                </List>

                <!-- ── Bio ── -->
                <VBox class="sapUiMediumMarginBeginEnd sapUiSmallMarginTop sapUiSmallMarginBottom">
                    <Title text="{i18n>profileAbout}" level="H5" class="sapUiTinyMarginBottom"/>
                    <Text text="{path:'appData>/selectedProfile/bio', formatter:'.formatBio'}" wrapping="true"/>
                </VBox>

                <!-- ── Reviews ── -->
                <VBox class="sapUiMediumMarginBeginEnd sapUiSmallMarginTop">
                    <Title text="{i18n>reviews}" level="H5" class="sapUiTinyMarginBottom"/>
                    <List id="reviewsList"
                        items="{appData>/selectedProfile/reviews}"
                        noDataText="{i18n>noReviewsYet}"
                        showSeparators="None">
                        <CustomListItem>
                            <HBox alignItems="Start" class="sapUiTinyMarginTopBottom">
                                <Avatar initials="{appData>reviewer_initials}" displaySize="XS" class="sapUiSmallMarginEnd"/>
                                <VBox width="100%">
                                    <HBox justifyContent="SpaceBetween" alignItems="Center">
                                        <Text text="{appData>reviewer_name}" class="fontBold smallText"/>
                                        <RatingIndicator value="{appData>stars}" maxValue="5" displayOnly="true" iconSize="12px"/>
                                    </HBox>
                                    <Text text="{appData>created_at_relative}" class="smallText grayText"/>
                                    <Text text="{appData>comment}" wrapping="true" class="smallText"/>
                                </VBox>
                            </HBox>
                        </CustomListItem>
                    </List>

                    <!-- Reviewing is a separate, focused task, and only offered
                         once a booking with this helper has completed — the form
                         used to sit inline under the reviews on every profile, so
                         anyone could rate anyone they had never met. -->
                    <Button text="{i18n>leaveReview}" icon="sap-icon://feedback" type="Default"
                        width="100%" class="sapUiSmallMarginTop"
                        press="onOpenRatingDialog"
                        visible="{appData>/canRateSelectedProfile}"/>
                </VBox>

                <!-- The overflow menu alone was not discoverable: nobody thinks to
                     tap three dots to block someone. This repeats the same sheet at
                     the foot of the profile, where people actually look for it,
                     without letting safety actions compete with Book and Message at
                     the top. Both entry points open the same ActionSheet. -->
                <Button text="{i18n>reportOrBlock}" icon="sap-icon://shield"
                    type="Transparent" width="100%"
                    class="sapUiSmallMarginTop sapUiSmallMarginBottom"
                    press="onProfileOverflow"
                    visible="{appData>/isOtherProfile}"/>


            </VBox>
        </content>

        <endButton>
            <Button text="{i18n>close}" press="onCloseProfile"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>
