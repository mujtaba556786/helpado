<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Dialog id="profileDialog"
        title="{appData>/selectedProfile/name}"
        verticalScrolling="true"
        stretch="true">

        <customHeader>
            <Bar>
                <contentMiddle>
                    <Title text="{appData>/selectedProfile/name}" level="H4"/>
                </contentMiddle>
                <!-- A customHeader replaces the default one, which took the close
                     affordance with it — the only way out was a text link below all
                     the content. Matches DmChatDialog / NotificationsDialogV2. -->
                <contentRight>
                    <Button icon="sap-icon://decline" tooltip="{i18n>close}"
                        type="Transparent" press="onCloseProfile"/>
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <VBox>

                <!-- ── Hero ── -->
                <HBox alignItems="Center"
                    class="sapUiMediumMarginBeginEnd sapUiMediumMarginTop sapUiSmallMarginBottom">
                    <Avatar
                        src="{appData>/selectedProfile/photo}"
                        initials="{appData>/selectedProfile/initials}"
                        displaySize="L"
                        class="sapUiMediumMarginEnd"/>
                    <VBox>
                        <Text text="{appData>/selectedProfile/serviceType}" class="smallText"/>
                        <HBox alignItems="Center" class="sapUiTinyMarginTop">
                            <RatingIndicator value="{appData>/selectedProfile/rating}" maxValue="5" visualMode="Half" displayOnly="true" class="sapUiTinyMarginEnd"/>
                            <Text text="{appData>/selectedProfile/ratingLabel}" class="smallText"/>
                        </HBox>
                        <!-- Facts, not a badge. This slot used to show
                             "Verified User" from an internal moderation score;
                             nothing in the product verifies identity. -->
                        <Text text="{path:'appData>/selectedProfile/created_at', formatter:'.formatMemberSince'}"
                            visible="{= !!${appData>/selectedProfile/created_at} }"
                            class="smallText grayText sapUiTinyMarginTop"/>
                        <Text text="{path:'appData>/selectedProfile/completed_jobs', formatter:'.formatJobsCompleted'}"
                            visible="{= ${appData>/selectedProfile/completed_jobs} > 0 }"
                            class="smallText grayText"/>
                    </VBox>
                </HBox>

                <!-- ── Action buttons (only for other people) ── -->
                <HBox justifyContent="SpaceAround"
                    class="sapUiMediumMarginBeginEnd sapUiSmallMarginBottom"
                    visible="{appData>/isOtherProfile}">
                    <Button text="{i18n>book}"    icon="sap-icon://appointment-2" type="Emphasized" press="onOpenBooking"/>
                    <Button text="{i18n>messageAction}" icon="sap-icon://discussion"    type="Default"    press="onStartDm"/>
                    <!-- Ask AI hidden until the feature is ready: /api/chat has no ANTHROPIC_API_KEY
                         set, so every tap fails. Re-enable by removing visible="false" once the key is
                         configured and the route has auth + rate limiting. -->
                    <Button text="Ask AI"  icon="sap-icon://da"            type="Default"    press="onOpenChat" visible="false"/>
                </HBox>

                <!-- ── Edit Profile shortcut (only for own profile) ── -->
                <HBox justifyContent="Center"
                    class="sapUiMediumMarginBeginEnd sapUiSmallMarginBottom"
                    visible="{appData>/isOwnProfile}">
                    <Button text="{i18n>editProfile}" icon="sap-icon://edit" type="Emphasized"
                        press="onEditProfileFromDialog" width="100%"/>
                </HBox>

                <!-- ── Info rows ──────────────────────────────────────────────────
                     Rebuilt off StandardListItem. It gave the icon a fixed 44px box but
                     let the glyph inherit the app's line-height, which scales with the
                     Android system font: measured on device at 1.3x the glyph needed
                     57px inside that 44px box and rendered clipped. It also let each
                     glyph keep its own natural width, so the four icons did not start
                     on the same vertical line.

                     The list now carries the same margin class as the About and Reviews
                     blocks below, so the icon column lines up with those headings
                     instead of running edge to edge across the dialog. -->
                <!-- width="auto": List defaults to 100%, so the side margins below
                     would add on top of a full-width box and push the values ~32px past
                     the dialog edge (measured on device: row 32..443 in a 411px dialog). -->
                <List width="auto" showSeparators="Inner"
                      class="sapUiSmallMarginBottom sapUiMediumMarginBeginEnd">
                    <CustomListItem type="Inactive">
                        <HBox alignItems="Center" justifyContent="SpaceBetween" width="100%"
                              class="sapUiTinyMarginTopBottom">
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://money-bills" size="1.25rem" width="1.75rem"
                                           color="#2E8B57" class="sapUiTinyMarginEnd"/>
                                <Text text="{i18n>bookingRate}"/>
                            </HBox>
                            <Text text="{appData>/selectedProfile/rateDisplay}"/>
                        </HBox>
                    </CustomListItem>
                    <CustomListItem type="Inactive">
                        <HBox alignItems="Center" justifyContent="SpaceBetween" width="100%"
                              class="sapUiTinyMarginTopBottom">
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://history" size="1.25rem" width="1.75rem"
                                           color="#2E8B57" class="sapUiTinyMarginEnd"/>
                                <Text text="{i18n>profileExperience}"/>
                            </HBox>
                            <Text text="{= ${appData>/selectedProfile/years} ? ${appData>/selectedProfile/years} + ' years' : '—'}"/>
                        </HBox>
                    </CustomListItem>
                    <CustomListItem type="Inactive">
                        <HBox alignItems="Center" justifyContent="SpaceBetween" width="100%"
                              class="sapUiTinyMarginTopBottom">
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://world" size="1.25rem" width="1.75rem"
                                           color="#2E8B57" class="sapUiTinyMarginEnd"/>
                                <Text text="{i18n>profileLanguage}"/>
                            </HBox>
                            <Text text="{= ${appData>/selectedProfile/languages} || '—'}"/>
                        </HBox>
                    </CustomListItem>
                    <CustomListItem type="Inactive">
                        <HBox alignItems="Center" justifyContent="SpaceBetween" width="100%"
                              class="sapUiTinyMarginTopBottom">
                            <HBox alignItems="Center">
                                <core:Icon src="sap-icon://map" size="1.25rem" width="1.75rem"
                                           color="#2E8B57" class="sapUiTinyMarginEnd"/>
                                <Text text="{i18n>location}"/>
                            </HBox>
                            <Text text="{= ${appData>/selectedProfile/city} || '—'}" wrapping="true"/>
                        </HBox>
                    </CustomListItem>
                </List>

                <!-- ── Bio ── -->
                <VBox class="sapUiMediumMarginBeginEnd sapUiSmallMarginTop sapUiSmallMarginBottom">
                    <Title text="{i18n>profileAbout}" level="H5" class="sapUiTinyMarginBottom"/>
                    <Text text="{path:'appData>/selectedProfile/bio', formatter:'.formatBio'}" wrapping="true"/>
                </VBox>

                <!-- ── Reviews ── -->
                <VBox class="sapUiMediumMarginBeginEnd sapUiSmallMarginTop">
                    <Title text="{i18n>reviews}" level="H5" class="sapUiTinyMarginBottom"/>
                    <List id="reviewsList"
                        items="{appData>/selectedProfile/reviews}"
                        noDataText="{i18n>noReviewsYet}"
                        showSeparators="None">
                        <CustomListItem>
                            <HBox alignItems="Start" class="sapUiTinyMarginTopBottom">
                                <Avatar initials="{appData>reviewer_initials}" displaySize="XS" class="sapUiSmallMarginEnd"/>
                                <VBox width="100%">
                                    <HBox justifyContent="SpaceBetween" alignItems="Center">
                                        <Text text="{appData>reviewer_name}" class="fontBold smallText"/>
                                        <RatingIndicator value="{appData>stars}" maxValue="5" displayOnly="true" iconSize="12px"/>
                                    </HBox>
                                    <Text text="{appData>created_at_relative}" class="smallText grayText"/>
                                    <Text text="{appData>comment}" wrapping="true" class="smallText"/>
                                </VBox>
                            </HBox>
                        </CustomListItem>
                    </List>

                    <!-- Reviewing is a separate, focused task, and only offered
                         once a booking with this helper has completed — the form
                         used to sit inline under the reviews on every profile, so
                         anyone could rate anyone they had never met. -->
                    <Button text="{i18n>leaveReview}" icon="sap-icon://feedback" type="Default"
                        width="100%" class="sapUiSmallMarginTop"
                        press="onOpenRatingDialog"
                        visible="{appData>/canRateSelectedProfile}"/>
                </VBox>

                <!-- Safety actions, named and reachable in one tap.
                     They were behind a ⋯ overflow menu, which nobody thinks to tap
                     to block someone, and which needed an ActionSheet — and that
                     sheet's cancel button was the pink one that kept looking wrong.
                     Two plain links remove the menu, the sheet and a whole tap.
                     They sit last on the page and stay muted so they do not compete
                     with Book and Message: findable, without framing every helper as
                     a suspect. Each opens its own dialog directly. -->
                <VBox class="sapUiSmallMarginTop sapUiSmallMarginBottom"
                    visible="{appData>/isOtherProfile}">
                    <Button text="{i18n>reportThisHelper}" icon="sap-icon://flag"
                        type="Transparent" width="100%" press="onReportUser"/>
                    <Button text="{i18n>blockThisHelper}" icon="sap-icon://cancel"
                        type="Transparent" width="100%" press="onBlockUser"/>
                </VBox>


            </VBox>
        </content>

        <endButton>
            <Button text="{i18n>close}" press="onCloseProfile"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>
