<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Popover id="notificationsDialogV2"
        title="{i18n>notifications}"
        contentWidth="360px"
        contentHeight="420px"
        placement="Bottom"
        showHeader="true"
        verticalScrolling="false">

        <customHeader>
            <Bar>
                <contentLeft>
                    <Title text="{i18n>notifications}"/>
                </contentLeft>
                <contentRight>
                    <Button text="{i18n>markAllRead}" type="Transparent" press="onMarkAllRead"
                        visible="{= ${appData>/unreadCount} > 0}"/>
                    <Button icon="sap-icon://decline" type="Transparent" press="onCloseNotifications"/>
                </contentRight>
            </Bar>
        </customHeader>

        <content>
            <VBox>
                <!-- Filter chips -->
                <HBox alignItems="Center" class="sapUiTinyMarginBeginEnd sapUiTinyMarginTopBottom" wrap="Wrap">
                    <Button text="{i18n>notifAll}" type="{= ${appData>/notifFilter} === 'all'       ? 'Emphasized' : 'Default'}" press="onNotifFilter" class="sapUiTinyMarginEnd">
                        <customData><core:CustomData key="filter" value="all"/></customData>
                    </Button>
                    <Button text="{i18n>notifToday}" type="{= ${appData>/notifFilter} === 'today'     ? 'Emphasized' : 'Default'}" press="onNotifFilter" class="sapUiTinyMarginEnd">
                        <customData><core:CustomData key="filter" value="today"/></customData>
                    </Button>
                    <Button text="{i18n>notifYesterday}" type="{= ${appData>/notifFilter} === 'yesterday' ? 'Emphasized' : 'Default'}" press="onNotifFilter" class="sapUiTinyMarginEnd">
                        <customData><core:CustomData key="filter" value="yesterday"/></customData>
                    </Button>
                    <Button text="{i18n>notifEarlier}" type="{= ${appData>/notifFilter} === 'earlier'   ? 'Emphasized' : 'Default'}" press="onNotifFilter" class="sapUiTinyMarginEnd">
                        <customData><core:CustomData key="filter" value="earlier"/></customData>
                    </Button>
                </HBox>

                <!-- Notification list -->
                <List id="notificationsList"
                    items="{appData>/filteredNotifications}"
                    noDataText="{i18n>noNotificationsYet}"
                    showSeparators="None">
                    <CustomListItem type="Active" press="onNotifPress">
                        <HBox alignItems="Start" class="sapUiSmallMarginBeginEnd sapUiTinyMarginTopBottom">

                            <!-- Icon bubble -->
                            <VBox justifyContent="Center" alignItems="Center" width="2.5rem">
                                <core:Icon
                                    src="{path:'appData>type', formatter:'.formatNotifIconSrc'}"
                                    color="{path:'appData>type', formatter:'.formatNotifIconColor'}"
                                    size="1.1rem"/>
                            </VBox>

                            <!-- Content -->
                            <VBox class="sapUiTinyMarginBegin" width="100%">
                                <HBox justifyContent="SpaceBetween" alignItems="Start">
                                    <Text text="{appData>title}" class="fontBold smallText"/>
                                    <core:Icon src="sap-icon://circle-task" color="Highlight" size="0.55rem" visible="{= !${appData>is_read}}" class="sapUiTinyMarginBegin"/>
                                </HBox>
                                <Text text="{appData>message}" class="smallText" wrapping="true"/>
                                <Text text="{path:'appData>created_at', formatter:'.formatNotifTime'}" class="smallText grayText"/>
                            </VBox>

                            <!-- Mark read -->
                            <Button
                                icon="sap-icon://accept"
                                type="Transparent"
                                tooltip="{i18n>markAsRead}"
                                visible="{= !${appData>is_read}}"
                                press="onNotifMarkOneRead"/>
                        </HBox>
                    </CustomListItem>
                </List>
            </VBox>
        </content>

    </Popover>

</core:FragmentDefinition>
