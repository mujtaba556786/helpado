<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <!--
      Experts filter popover — anchored to the "Filter" button on the search page.
      Holds availability + quality only; Distance and Language live inline on the
      search page (see Dashboard.view.xml). Filter logic is unchanged — see FilterMixin.
    -->
    <Popover id="expertFiltersPopover"
        title="{i18n>filterTitle}"
        placement="Bottom"
        contentWidth="300px">

        <VBox class="sapUiSmallMargin">

            <!-- Availability -->
            <Label text="{i18n>filterAvailability}" design="Bold" class="sapUiTinyMarginBottom"/>
            <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
                <Text text="{i18n>availableNow}"/>
                <Switch state="{appData>/filters/availableNow}" change="onAvailableNowSwitch"/>
            </HBox>

            <!-- Show (quality) -->
            <Label text="{i18n>filterShow}" design="Bold" class="sapUiTinyMarginBottom"/>
            <!-- Was a three-item SegmentedButton labelled All / Top rated / Budget.
                 Two problems: the labels shared one row, so they truncated to
                 "Top r..." at larger system font sizes, and the heading "Show"
                 never said what the options do — one filters on RATING (>= 4.8),
                 the other on PRICE (<= EUR 25/h), which are not alternatives to
                 each other in any obvious way. One row each, thresholds stated. -->
            <RadioButtonGroup columns="1"
                selectedIndex="{= ${appData>/filters/priceCategory} === 'top' ? 1 : ${appData>/filters/priceCategory} === 'budget' ? 2 : 0 }"
                select="onPriceCategorySelect"
                class="sapUiSmallMarginBottom">
                <RadioButton text="{i18n>filterOptionAll}"/>
                <RadioButton text="{i18n>filterOptionTop}"/>
                <RadioButton text="{i18n>filterOptionBudget}"/>
            </RadioButtonGroup>

            <!-- Reset -->
            <Button text="{i18n>resetFilters}"
                icon="sap-icon://undo"
                type="Transparent"
                press="onResetFilters"
                visible="{= ${appData>/filters/activeCount} > 0}"
                class="hhResetBtn"/>

        </VBox>
    </Popover>
</core:FragmentDefinition>
