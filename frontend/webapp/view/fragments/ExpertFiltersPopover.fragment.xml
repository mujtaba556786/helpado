<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <!--
      Experts filter popover — anchored to the "Filter" button on the search page.
      Holds availability + quality only; Distance and Language live inline on the
      search page (see Dashboard.view.xml). Filter logic is unchanged — see FilterMixin.
    -->
    <Popover id="expertFiltersPopover"
        title="{i18n>filterTitle}"
        placement="Bottom"
        contentWidth="300px">

        <VBox class="sapUiSmallMargin">

            <!-- Availability -->
            <Label text="{i18n>filterAvailability}" design="Bold" class="sapUiTinyMarginBottom"/>
            <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMarginBottom">
                <Text text="{i18n>availableNow}"/>
                <Switch state="{appData>/filters/availableNow}" change="onAvailableNowSwitch"/>
            </HBox>

            <!-- Show (quality) -->
            <Label text="{i18n>filterShow}" design="Bold" class="sapUiTinyMarginBottom"/>
            <SegmentedButton width="100%"
                selectedKey="{appData>/filters/priceCategory}"
                selectionChange="onPriceCategorySelect"
                class="sapUiSmallMarginBottom">
                <items>
                    <SegmentedButtonItem key="all"    text="{i18n>all}"/>
                    <SegmentedButtonItem key="top"    text="{i18n>topRated}"/>
                    <SegmentedButtonItem key="budget" text="{i18n>budgetFilter}"/>
                </items>
            </SegmentedButton>

            <!-- Reset -->
            <Button text="{i18n>resetFilters}"
                icon="sap-icon://undo"
                type="Transparent"
                press="onResetFilters"
                visible="{= ${appData>/filters/activeCount} > 0}"
                class="hhResetBtn"/>

        </VBox>
    </Popover>
</core:FragmentDefinition>
