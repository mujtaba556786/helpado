<mvc:View
    controllerName="helphub.controller.Login"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page showHeader="false">
        <!-- SpaceBetween keeps the card optically centred while the neighbourhood
             scene stays pinned to the bottom edge. The first VBox is an empty
             flexible spacer — without it the card would sit against the top. -->
        <FlexBox height="100vh" alignItems="Center" justifyContent="SpaceBetween" direction="Column" class="loginBg">
            <VBox/>
            <VBox width="90%" class="loginCard maxWidth400">
                <VBox alignItems="Center" class="sapUiMediumMargin">
                    <Avatar id="brandLogo" displaySize="XL" displayShape="Square" imageFitType="Contain"
                        class="sapUiSmallMarginBottom" src="{appData>/logoUrl}" tooltip="{i18n>appTitle}"/>
                    <Title text="{i18n>loginTitle}" level="H1" class="sapUiTinyMarginBottom"/>
                    <Text id="brandSubtitle" text="{i18n>loginNeighborhoodNetwork}" width="100%"
                        textAlign="Center" class="grayText sapUiTinyMarginBottom"/>
                    <Text text="{i18n>loginTagline}" width="100%" textAlign="Center" wrapping="true"/>
                </VBox>

                <!-- Step 0: Session check — shown on every app open while token is verified -->
                <VBox id="stepProcessing" visible="{appData>/magicLinkProcessing}" alignItems="Center" class="sapUiMediumMargin">
                    <core:Icon src="sap-icon://locked" size="3rem" color="#4FB584" class="sapUiSmallMarginBottom"/>
                    <Title text="{i18n>loginResuming}" level="H3" class="sapUiSmallMarginBottom"/>
                    <Text text="{i18n>loginResumingHint}" class="grayText textCenter sapUiSmallMarginBottom"/>
                    <BusyIndicator size="2rem"/>
                </VBox>

                <!-- Step 1: Enter Email — hidden while processing magic link -->
                <VBox id="stepEmail" class="sapUiMediumMargin" visible="{= !${appData>/magicLinkProcessing} }">
                    <Label text="{i18n>loginEmailLabel}"/>
                    <Input id="emailInput" type="Email" placeholder="{i18n>loginEmailPlaceholder}" class="sapUiSmallMarginBottom"/>
                    <Button id="signInButton" text="{i18n>loginSendLink}" type="Emphasized" width="100%" press="onSendMagicLink"/>
                </VBox>

                <!-- Step 2: Link sent + enter 6-digit code -->
                <VBox id="stepLinkSent" class="sapUiMediumMargin" visible="false">
                    <VBox alignItems="Center" class="sapUiSmallMarginBottom">
                        <Title text="{i18n>loginCheckInbox}" level="H3"/>
                        <Text id="linkSentHint" text="" class="grayText textCenter sapUiTinyMarginTop sapUiSmallMarginBottom"/>
                        <Text text="{i18n>loginClickLink}" class="grayText textCenter"/>
                    </VBox>
                    <Label text="{i18n>loginCodeLabel}" class="sapUiSmallMarginTop"/>
                    <Input id="otpInput" type="Number" maxLength="6" placeholder="{i18n>loginCodePlaceholder}" class="sapUiTinyMarginBottom" submit="onVerifyOtp"/>
                    <Button text="{i18n>loginVerifyCode}" type="Emphasized" width="100%" press="onVerifyOtp"/>
                    <Button text="{i18n>loginResendLink}" type="Transparent" width="100%" class="sapUiSmallMarginTop" press="onResendMagicLink"/>
                    <Button text="{i18n>loginDifferentEmail}" type="Ghost" width="100%" class="sapUiTinyMarginTop" press="onBackToEmail"/>
                </VBox>
            </VBox>

            <!-- Neighbourhood scene, edge to edge along the bottom -->
            <VBox width="100%">
                <Image id="brandScene" src="{appData>/sceneUrl}" width="100%" densityAware="false"
                    decorative="true" class="sapUiSmallMarginTop"/>
            </VBox>
        </FlexBox>
    </Page>
</mvc:View>
